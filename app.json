{
  "expo": {
    "name": "ShubhPanchang",
    "slug": "shubhpanchang",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon-light.png",
    "scheme": "shubhpanchang",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "in.shubhpanchang.app",
      "supportsTablet": false,
      "associatedDomains": [
        "applinks:shubhpanchang.in"
      ],
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "CFBundleDevelopmentRegion": "en"
      },
      "appleTeamId": "2GX4UMPT5P",
      "icon": {
        "light": "./assets/images/icon-light.png",
        "dark": "./assets/images/icon-dark.png",
        "tinted": "./assets/images/icon-tinted.png"
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "in.shubhpanchang.app",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF8F0",
          "image": "./assets/images/icon-light.png",
          "imageWidth": 120
        }
      ],
      "expo-localization",
      "expo-sqlite",
      "expo-notifications",
      [
        "expo-calendar",
        {
          "writeOnlyAccess": true,
          "writeOnlyCalendarPermission": "ShubhPanchang adds vrat days and family tithi dates to your calendar when you ask it to.",
          "calendarPermission": "ShubhPanchang adds vrat days and family tithi dates to your calendar when you ask it to.",
          "remindersPermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Your location sets sunrise, Rahu Kaal and the Parana time for where you are. It is rounded to about 1 km and never stored on our server."
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-widgets",
        {
          "bundleIdentifier": "in.shubhpanchang.app.widgets",
          "groupIdentifier": "group.in.shubhpanchang.app",
          "widgets": [
            {
              "name": "TodayWidget",
              "displayName": "Today",
              "description": "Is now a good time, until when, and the tithi.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "accessoryRectangular",
                  "accessoryInline",
                  "accessoryCircular"
                ],
                "initialLayout": "./src/widgets/today-widget.tsx"
              }
            },
            {
              "name": "VratWidget",
              "displayName": "Next vrat",
              "description": "The coming fast and when to break it.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "accessoryRectangular"
                ],
                "initialLayout": "./src/widgets/vrat-widget.tsx"
              }
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "locales": {
      "en": "./locales/en.json",
      "gu": "./locales/gu.json"
    }
  }
}
